{
  "name": "authapp",
  "version": "0.3.9",
  "private": true,
  "description": "Cross-platform, offline desktop authenticator for Windows and Linux",
  "desktopName": "Authly",
  "author": "Arda Kartal <ardakartaskisisel@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardakrt/authly.git"
  },
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron && electron-builder install-app-deps",
    "predev": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "presmoke": "electron-builder install-app-deps",
    "smoke": "node scripts/smoke.mjs",
    "smoke:visual": "node scripts/smoke.mjs --visual",
    "verify": "npm run format:check && npm run lint && npm run test && npm run build && npm run smoke",
    "package:win": "npm run verify && electron-builder --win nsis --x64",
    "package:linux": "npm run verify && electron-builder --linux AppImage deb --x64",
    "package:linux:fast": "npm run build && electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "jsqr": "^1.4.0",
    "lucide-react": "1.61.0",
    "otpauth": "^9.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.8.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "build": {
    "appId": "dev.authapp.desktop",
    "productName": "Authly",
    "publish": [
      {
        "provider": "github",
        "owner": "ardakrt",
        "repo": "authly"
      }
    ],
    "asar": true,
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "artifactName": "Authly-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Utility;Security",
      "executableName": "authly",
      "syncDesktopName": true,
      "artifactName": "Authly-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "packageCategory": "utils",
      "priority": "optional"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
